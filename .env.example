# --- LLM provider ---
# This project uses the OpenAI Python SDK (openai==3.8.0) directly. Any
# OpenAI-compatible endpoint works by also setting OPENAI_BASE_URL.
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini

# --- Database ---
# Path to the SQLite file. build_db.py creates it from db/schema.sql and
# data/seed/*.json. Relative to the repo root.
DATABASE_PATH=db/agent.db

# --- MCP server ---
# Host/port the MCP server listens on when run over HTTP (streamable-http
# transport). Not needed if you run it over stdio instead - see README.
MCP_SERVER_HOST=127.0.0.1
MCP_SERVER_PORT=8300
# If set, agent/mcp_client.py connects to a standalone MCP server process
# at this URL instead of the default in-memory transport. Leave unset for
# local dev - see DECISIONS.md #3.
# MCP_SERVER_URL=http://127.0.0.1:8300/mcp

# --- Agent loop ---
# Max tool-calling turns before the agent is forced to give a final
# answer, even if it hasn't finished gathering data.
MAX_TOOL_ITERATIONS=6

# --- API server ---
API_HOST=0.0.0.0
API_PORT=8000

# --- Guardrails ---
# Minimum number of DB rows a claim must be backed by before the agent
# will assert it as fact rather than hedge. See agent/guardrails.py.
MIN_SUPPORTING_ROWS=1
# Signals older than this are flagged as stale in the confidence score.
SIGNAL_STALENESS_DAYS=180
